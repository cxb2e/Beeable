rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (request.auth.token.email == "nguyenthanhtam.it2013@gmail.com" && request.auth.token.email_verified == true) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')
        );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string &&
             (!('role' in data) || data.role in ['student', 'teacher']) &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('photoURL' in data) || data.photoURL is string) &&
             (!('xp' in data) || data.xp is int) &&
             (!('coins' in data) || data.coins is int) &&
             (!('streak' in data) || data.streak is int) &&
             (!('lastActiveDate' in data) || data.lastActiveDate is string) &&
             (!('speakingLevel' in data) || data.speakingLevel is int) &&
             (!('writingLevel' in data) || data.writingLevel is int) &&
             (!('speakingProgress' in data) || data.speakingProgress is int) &&
             (!('writingProgress' in data) || data.writingProgress is int);
    }

    function isValidGameResult(data) {
      return data.keys().hasAll(['gameType', 'score', 'totalQuestions', 'date']) &&
             data.gameType is string &&
             data.score is int &&
             data.totalQuestions is int &&
             data.date is string &&
             (!('xpEarned' in data) || data.xpEarned is int) &&
             (!('coinsEarned' in data) || data.coinsEarned is int);
    }

    function isValidSpeakingAttempt(data) {
      return data.keys().hasAll(['targetText', 'recognizedText', 'isCorrect', 'score', 'date']) &&
             data.targetText is string &&
             data.recognizedText is string &&
             data.isCorrect is bool &&
             data.score is int &&
             (!('feedback' in data) || data.feedback is string) &&
             data.date is string &&
             (!('level' in data) || data.level is int) &&
             (!('xpEarned' in data) || data.xpEarned is int);
    }

    function isValidWritingCheck(data) {
      return data.keys().hasAll(['originalText', 'correctedText', 'feedback', 'date']) &&
             data.originalText is string &&
             data.correctedText is string &&
             data.feedback is string &&
             data.date is string &&
             (!('level' in data) || data.level is int) &&
             (!('xpEarned' in data) || data.xpEarned is int);
    }

    function isValidTheoryItem(data) {
      return data.keys().hasAll(['title', 'content', 'category']) &&
             data.title is string &&
             data.content is string &&
             data.category in ['lexical', 'technical', 'grammar'] &&
             (!('order' in data) || data.order is int);
    }

    function isValidGameQuestion(data) {
      return data.keys().hasAll(['question', 'options', 'answer']) &&
             data.question is string &&
             data.options is list &&
             data.answer is string &&
             (!('category' in data) || data.category is string) &&
             (!('order' in data) || data.order is int);
    }

    function isValidSpeakingPrompt(data) {
      return data.keys().hasAll(['text', 'translation']) &&
             data.text is string &&
             data.translation is string &&
             (!('category' in data) || data.category is string) &&
             (!('order' in data) || data.order is int);
    }

    function isValidWritingTopic(data) {
      return data.keys().hasAll(['title', 'description']) &&
             data.title is string &&
             data.description is string &&
             (!('category' in data) || data.category is string) &&
             (!('order' in data) || data.order is int);
    }

    function isValidDictationSentence(data) {
      return data.keys().hasAll(['text']) &&
             data.text is string &&
             (!('category' in data) || data.category is string) &&
             (!('order' in data) || data.order is int);
    }

    function isValidUserTask(data) {
      return data.keys().hasAll(['title', 'completed', 'date']) &&
             data.title is string &&
             data.completed is bool &&
             data.date is string &&
             (!('time' in data) || data.time is string);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Global Read Access for Learning Content
    match /dictationSentences/{sentenceId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidDictationSentence(request.resource.data);
      allow delete: if isAdmin();
    }

    match /theoryItems/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidTheoryItem(request.resource.data);
      allow delete: if isAdmin();
    }

    match /gameQuestions/{questionId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidGameQuestion(request.resource.data);
      allow delete: if isAdmin();
    }

    match /speakingPrompts/{promptId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSpeakingPrompt(request.resource.data);
      allow delete: if isAdmin();
    }

    match /writingTopics/{topicId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidWritingTopic(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidUserProfile(request.resource.data);

      match /gameResults/{resultId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && isOwner(userId) && isValidGameResult(request.resource.data);
      }

      match /speakingAttempts/{attemptId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && isOwner(userId) && isValidSpeakingAttempt(request.resource.data);
      }

      match /writingChecks/{checkId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && isOwner(userId) && isValidWritingCheck(request.resource.data);
      }

      match /tasks/{taskId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && isOwner(userId) && isValidUserTask(request.resource.data);
        allow update: if isAuthenticated() && isOwner(userId) && isValidUserTask(request.resource.data);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
    }
  }
}
